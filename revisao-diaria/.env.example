# Copie este arquivo para .env e preencha os dois valores.
# O arquivo .env NUNCA deve ser commitado (já está no .gitignore).

# Chave da API da Anthropic — https://console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Token da integração Notion — https://www.notion.so/profile/integrations
# Crie uma integration "Internal", copie o "Internal Integration Token" (começa com ntn_)
# IMPORTANTE: conecte essa integration à página "Ações - Master" no Notion
# (abra a página → menu "..." → Connections → adicionar a integration)
NOTION_TOKEN=
